# Copy this file to `.env` (same folder) and fill in your key.
# `.env` is gitignored -- your key never leaves this machine.
# A variable exported in the shell overrides anything set here.

# --- models -------------------------------------------------------------
# Format: provider:model   (provider is gemini, ollama or anthropic)
# Extraction is the many calls; judging is the few that decide
# corroborates / contradicts / reconciled.
FACTLAYER_EXTRACT=gemini:gemini-3.8-flash
FACTLAYER_JUDGE=gemini:gemini-3.8-flash

# --- keys ---------------------------------------------------------------
# Free key from https://aistudio.google.com/apikey  (starts with AIza)
GEMINI_API_KEY=
# Only needed if a role above is set to anthropic:
# ANTHROPIC_API_KEY=

# --- pacing -------------------------------------------------------------
# Requests per minute per role. Check your real limits at
# https://aistudio.google.com/rate-limit -- setting these ABOVE your actual
# quota makes runs slower, not faster, because 429s trigger backoff.
FACTLAYER_EXTRACT_RPM=14
FACTLAYER_JUDGE_RPM=14
FACTLAYER_EXTRACT_CONCURRENCY=2
FACTLAYER_JUDGE_CONCURRENCY=2

# Characters per chunk. Bigger = fewer extraction calls = faster.
# 4000 splits most dense pages in two; 8000 fits most pages whole.
FACTLAYER_CHUNK_CHARS=8000

# --- local models (only used when a role is set to ollama:) --------------
# OLLAMA_HOST=http://localhost:11434
# FACTLAYER_OLLAMA_CTX=8192

# --- storage ------------------------------------------------------------
# FACTLAYER_DB=factlayer.db
# FACTLAYER_MAX_UPLOAD_MB=50
